# Required for live LLM extraction.
OPENAI_API_KEY=

# Default model for `coffee-value extract`.
# Start with gpt-4o-mini for cost-sensitive extraction evals; use a stronger
# model for hard pages when the fixture set shows quality gaps.
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_MODEL=gpt-5.5

# Optional extractor tuning.
COFFEE_VALUE_MAX_PAGE_TEXT_CHARS=60000
